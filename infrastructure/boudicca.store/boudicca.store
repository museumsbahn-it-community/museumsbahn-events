[{"first":{"category":"special_trip","registration":"pre-sales-only","description":"\nJakominiplatz (Schmidgasse) - Treffpunkt 15 Minuten vor Abfahrt","location.name":"Jakominiplatz (Schmidgasse) - Treffpunkt 15 Minuten vor Abfahrt","locomotive_type":"tram","recurrence.type":"rarely","tags":"history,museum,museum_event,railway_museum","pictureUrl":"https://www.tramway-museum-graz.at/kalender//media/img/nikolo-2023.jpg","url":"https://www.tramway-museum-graz.at/kalender/nikolobim-2025","sources:format=list":"https://www.tramway-museum-graz.at/kalender/","operator_id":"tramwaymuseum_graz","location_id":"tramwaymuseum_graz","pictureAltText":"Veranstaltungsbild von Tramway Museum Graz","pictureCopyright":"© Tramway Museum Graz","collectorName":"Tramwaymuseum Graz Collector","name":"Nikolobim","startDate:format=date":"2025-12-07T00:00:00+02:00"},"second":{"timeAdded":1760952594904}},{"first":{"category":"special_trip","registration":"ticket","description":"Klimt-Kaffee Jause\n\nTermine: Abfahrt Schiff: Weyregg 13.53 Uhr Attersee 14.15 Uhr Dauer: 2h 20min Leistungen: Schifffahrt, Klimt-Törtchen, Verlängerter Preis: pro Person € 38,10 Genießen Sie den Nachmittag an Bord unserer schwimmenden Kaffeehäuser mit herrlichem Ausblick auf das faszinierende Farbenspiel, das imposante Höllengebirge und die prächtigen Sommervillen. Dazu servieren wir Ihnen Kaffee und Klimt-Törtchen. Ein Genuss für alle Sinne! Zum Ticket-Shop Tickets ab Weyregg buchen Tickets ab Attersee buchen\nAnmeldung nur online bis 24 Stunden vor der Fahrt möglich!\nSollten Sie die Reservierung doch nicht in Anspruch nehmen können, geben Sie uns bitte bis 14.00 Uhr am Vortag Bescheid – ansonsten kann keine Rückerstattung erfolgen! Bitte beachten Sie, dass aus betrieblichen oder wetterbedingten Gründen, die Fahrt kurzfristig entfallen kann. In diesem Fall werden Sie per Mail benachrichtigt und es erfolgt eine automatische Rückerstattung des im Vorfeld bezahlten Betrages.","locomotive_type":"ship","recurrence.type":"rarely","tags":"history,museum,museum_event,railway_museum","pictureUrl":"https://atterseeschifffahrt.at/wp-content/uploads/2025/08/Herbstfahrten-mit-Kaffeejause-1024x682.jpg","pictureCopyright":"© Stern & Hafferl","url":"https://atterseeschifffahrt.at/ausfluege-events/nostalgiezug-schiff/","additionalEventsFromSourceUrl":"https://atterseeschifffahrt.at/ausfluege-events/nostalgiezug-schiff/","sources:format=list":"https://atterseeschifffahrt.at/ausfluege-events/nostalgiezug-schiff/","operator_id":"sth","location_id":"atterseeschiff","pictureAltText":"Veranstaltungsbild von Atterseeschifffahrt Nostalgie","collectorName":"Atterseeschifffahrt Collector","name":"Klimt-Kaffee Jause","startDate:format=date":"2025-09-29T14:15:00+02:00"},"second":{"timeAdded":1760952607404}},{"first":{"locomotive_type":"diesel","description":"Fahrtag auf der Bregenzerwaldbahn.\n\nFahrplan:\n             10:45 ab Bezau\n11:25 ab Schwarzenberg\n13:45 ab Bezau\n14:25 ab Schwarzenberg\n15:45 ab Bezau\n16:25 ab Schwarzenberg","registration":"reservation-recommended","url":"https://waelderbaehnle.at/fahrplanbetrieb-preise-2025","category":"museum_railway","tags":"history,historic_train,museum_train,museum_railway,narrow_gauge","sources:format=list":"https://waelderbaehnle.at/fahrplanbetrieb-preise-2025","operator_id":"waelderbaehnle","location_id":"waelderbaehnle","collectorName":"Wälderbähnle/Bregenzerwaldbahn Collector","name":"Bregenzerwaldbahn","startDate:format=date":"2026-08-22T10:45:00+02:00"},"second":{"timeAdded":1760952571583}},{"first":{"category":"special_trip","registration":"ticket","description":"Klimt-Kaffee Jause\n\nTermine: Abfahrt Schiff: Weyregg 13.53 Uhr Attersee 14.15 Uhr Dauer: 2h 20min Leistungen: Schifffahrt, Klimt-Törtchen, Verlängerter Preis: pro Person € 38,10 Genießen Sie den Nachmittag an Bord unserer schwimmenden Kaffeehäuser mit herrlichem Ausblick auf das faszinierende Farbenspiel, das imposante Höllengebirge und die prächtigen Sommervillen. Dazu servieren wir Ihnen Kaffee und Klimt-Törtchen. Ein Genuss für alle Sinne! Zum Ticket-Shop Tickets ab Weyregg buchen Tickets ab Attersee buchen\nAnmeldung nur online bis 24 Stunden vor der Fahrt möglich!\nSollten Sie die Reservierung doch nicht in Anspruch nehmen können, geben Sie uns bitte bis 14.00 Uhr am Vortag Bescheid – ansonsten kann keine Rückerstattung erfolgen! Bitte beachten Sie, dass aus betrieblichen oder wetterbedingten Gründen, die Fahrt kurzfristig entfallen kann. In diesem Fall werden Sie per Mail benachrichtigt und es erfolgt eine automatische Rückerstattung des im Vorfeld bezahlten Betrages.","locomotive_type":"ship","recurrence.type":"rarely","tags":"history,museum,museum_event,railway_museum","pictureUrl":"https://atterseeschifffahrt.at/wp-content/uploads/2025/08/Herbstfahrten-mit-Kaffeejause-1024x682.jpg","pictureCopyright":"© Stern & Hafferl","url":"https://atterseeschifffahrt.at/ausfluege-events/nostalgiezug-schiff/","additionalEventsFromSourceUrl":"https://atterseeschifffahrt.at/ausfluege-events/nostalgiezug-schiff/","sources:format=list":"https://atterseeschifffahrt.at/ausfluege-events/nostalgiezug-schiff/","operator_id":"sth","location_id":"atterseeschiff","pictureAltText":"Veranstaltungsbild von Atterseeschifffahrt Nostalgie","collectorName":"Atterseeschifffahrt Collector","name":"Klimt-Kaffee Jause","startDate:format=date":"2025-09-24T14:15:00+02:00"},"second":{"timeAdded":1760952607405}},{"first":{"pictureUrl":"https://image.jimcdn.com/app/cms/image/transf/dimension=409x1024:format=jpg/path/s2f0fe601b4494d15/image/i865d0e9acc538ce7/version/1756736604/image.jpg","description":"Juni 2026\n\nSonntag, 7., 14., 21. und 28. Juni 2026\n\nSteyr Lokalbahn ab: 14.00 18.30\nGrünburg ab: 11.00 17.00\n\nZuglok am 7. Juni 2026:\nBarwagen in jedem Zug.\n\nRot gekennzeichnete Abfahrten sind bereits für Gruppen ausgebucht!","url":"https://www.oegeg.at/termine/termine-schmalspur-steyrtalbahn/","sources:format=list":"https://www.oegeg.at/termine/termine-schmalspur-steyrtalbahn/","operator_id":"oegeg","location_id":"oegeg_schmalspur","pictureAltText":"Veranstaltungsbild von ÖGEG Steyrtalbahn","pictureCopyright":"© ÖGEG Steyrtalbahn","collectorName":"ÖGEG Schmalspur Termine","name":"Steyrtal Museumsbahn","startDate:format=date":"2026-06-14T00:00:00+02:00"},"second":{"timeAdded":1760952571481}},{"first":{"pictureUrl":"https://image.jimcdn.com/app/cms/image/transf/dimension=421x1024:format=jpg/path/s2f0fe601b4494d15/image/icd48c9ee7ee79afc/version/1756736508/image.jpg","description":"August 2026\n\nSamstag, 01., 08., 15., 22 und 29. August 2026\nSonntag, 02., 09., 16., 23. und 30. August 2026\n\nSteyr Lokalbahn ab: 14.00 18.30\nGrünburg ab: 11.00 17.00\n\nZuglok am 01. und 02. August 2026:\nBarwagen in jedem Zug.\n\nRot gekennzeichnete Abfahrten sind bereits für Gruppen ausgebucht!","url":"https://www.oegeg.at/termine/termine-schmalspur-steyrtalbahn/","sources:format=list":"https://www.oegeg.at/termine/termine-schmalspur-steyrtalbahn/","operator_id":"oegeg","location_id":"oegeg_schmalspur","pictureAltText":"Veranstaltungsbild von ÖGEG Steyrtalbahn","pictureCopyright":"© ÖGEG Steyrtalbahn","collectorName":"ÖGEG Schmalspur Termine","name":"Steyrtal Museumsbahn","startDate:format=date":"2026-08-22T00:00:00+02:00"},"second":{"timeAdded":1760952571507}},{"first":{"category":"museum_railway","url":"http://www.mh6.at/de/besuchen-sie-uns-beim-anbrennen-der-mh-6-8-2/","recurrence.type":"rarely","registration":"ticket","description":"Besuchen Sie uns beim Anbrennen der Mh.6\n\nBesuchen Sie uns im Heizhaus Ober-Grafendorf bei den Vorbereitungsarbeiten für einen Dampfzug nach Mariazell. Am Tag vor der Fahrt muss das Feuer in der Dampflok angezündet werden, damit sich Temperatur und Druck möglichst langsam aufbauen können. Von Mai bis September erfolgt das Entzünden des Feuers um 16 Uhr. Ab Oktober bereits eine Stunde früher um 15 Uhr.\nWie funktioniert eigentlich so eine Dampflok? Was ist alles zu tun, damit sie fahren kann? Wofür sind all diese Räder und Hebel am Führerstand? Die Antworten auf diese und auch alle anderen Fragen können erforscht werden.\nAn den Nachmittagen von Mai bis Oktober wird eine Fahrt mit einem Dieselzug auf der „Krumpen“ angeboten. Voraussichtlich wird die 2091.11 eingesetzt werden. Der Zug wird gegen 16:30, im Oktober um 15:30 Uhr, beim Heizhaus abfahren. Den Tag können Sie nach diesen Fahrten gemütlich bei einem kleinen Gillfest im Heizhaus ausklingen lassen!\n11. Mai 2024 7. Juni 2024 13. Juli 2024 10. August 2024 7. September 2024 12. Oktober 2024 (abgesagt) 23. November 2024 30. November 2024 7. Dezember 2024 14. Dezember 2024 21. Dezember 2024\nGäste sind herzlich willkommen!","locomotive_type":"diesel_train","tags":"history,historic_train,museum_train,museum_railway,narrow_gauge","additionalEventsFromSourceUrl":"http://www.mh6.at/de/termine/","pictureUrl":"http://www.mh6.at/wp-content/uploads/2017/01/IMG_1847b-1024x683.jpg","sources:format=list":"http://www.mh6.at/","operator_id":"mh6","location_id":"mh6_heizhaus_krumpe","pictureAltText":"Veranstaltungsbild von Verein Mh.6 Heizhaus Ober-Grafendorf und Krumpe","pictureCopyright":"© Verein Mh.6 Heizhaus Ober-Grafendorf und Krumpe","collectorName":"Mh6 Collector","name":"Anheizen der Mh.6","startDate:format=date":"2024-12-07T00:00:00+02:00"},"second":{"timeAdded":1760952596829}},{"first":{"category":"special_trip","registration":"ticket","pictureUrl":"/sites/waelderbaehnle.at/files/styles/news_1x/public/2025-01/Veranstaltung%201a.jpg?itok=aFl5bppt","description":"Abdampfen 2025“ – letzter Betriebstag der Dampflokomotiven mit Einblicken hinter die Kulissen des Dampflokbetriebes","url":"https://waelderbaehnle.at/aktuelles/veranstaltungskalender-2025","tags":"history,museum,museum_event,railway_museum,historic_train,museum_train,museum_railway,narrow_gauge","sources:format=list":"https://waelderbaehnle.at/fahrplanbetrieb-preise-2025","operator_id":"waelderbaehnle","location_id":"waelderbaehnle","pictureAltText":"Veranstaltungsbild von Bregenzerwaldbahn Museumsbahn","pictureCopyright":"© Bregenzerwaldbahn Museumsbahn","collectorName":"Wälderbähnle/Bregenzerwaldbahn Collector","name":"Abdampfen 2025","startDate:format=date":"2025-10-18T00:00:00+02:00"},"second":{"timeAdded":1760952571591}},{"first":{"locomotive_type":"diesel","description":"Fahrtag auf der Bregenzerwaldbahn.\n\nFahrplan:\n             10:45 ab Bezau\n11:25 ab Schwarzenberg\n13:45 ab Bezau\n14:25 ab Schwarzenberg\n15:45 ab Bezau\n16:25 ab Schwarzenberg","registration":"reservation-recommended","url":"https://waelderbaehnle.at/fahrplanbetrieb-preise-2025","category":"museum_railway","tags":"history,historic_train,museum_train,museum_railway,narrow_gauge","sources:format=list":"https://waelderbaehnle.at/fahrplanbetrieb-preise-2025","operator_id":"waelderbaehnle","location_id":"waelderbaehnle","collectorName":"Wälderbähnle/Bregenzerwaldbahn Collector","name":"Bregenzerwaldbahn","startDate:format=date":"2026-08-30T10:45:00+02:00"},"second":{"timeAdded":1760952571584}},{"first":{"locomotive_type":"diesel","description":"Fahrtag auf der Bregenzerwaldbahn.\n\nFahrplan:\n             10:45 ab Bezau\n11:25 ab Schwarzenberg\n13:45 ab Bezau\n14:25 ab Schwarzenberg\n15:45 ab Bezau\n16:25 ab Schwarzenberg","registration":"reservation-recommended","url":"https://waelderbaehnle.at/fahrplanbetrieb-preise-2025","category":"museum_railway","tags":"history,historic_train,museum_train,museum_railway,narrow_gauge","sources:format=list":"https://waelderbaehnle.at/fahrplanbetrieb-preise-2025","operator_id":"waelderbaehnle","location_id":"waelderbaehnle","collectorName":"Wälderbähnle/Bregenzerwaldbahn Collector","name":"Bregenzerwaldbahn","startDate:format=date":"2026-05-24T10:45:00+02:00"},"second":{"timeAdded":1760952571573}},{"first":{"category":"special_trip","registration":"pre-sales-only","description":"\nJakominiplatz (Schmidgasse) - Treffpunkt 15 Minuten vor Abfahrt","location.name":"Jakominiplatz (Schmidgasse) - Treffpunkt 15 Minuten vor Abfahr